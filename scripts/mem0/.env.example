# Mem0 自托管环境变量（复制为 .env 后使用）
# docker compose -f docker-compose.mem0.yml --env-file scripts/mem0/.env up -d

# ---- 提供商密钥（Mem0 抽取记忆用 LLM + Embedding）----
# 默认 OpenAI；至少填一个
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- 鉴权 ----
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-openssl-rand-base64-48
# 16 字符以上；平台 amp.mem0.api-key 填同一个值（或 Dashboard 发的 m0sk_...）
ADMIN_API_KEY=amp-mem0-admin-key-please-rotate
# 仅本地调试可 true，生产禁止
AUTH_DISABLED=false

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mem0pass

# ---- 端口 / 镜像 ----
MEM0_API_HOST_PORT=8888
MEM0_PG_HOST_PORT=15433
MEM0_DASH_HOST_PORT=3000
# 镜像拉不到时可改为本地构建（见 docker-compose.mem0.yml 注释）
MEM0_IMAGE=mem0/mem0-api-server:latest
MEM0_DASHBOARD_IMAGE=mem0/mem0-dashboard:latest

DASHBOARD_URL=http://localhost:3000
